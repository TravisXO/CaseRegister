# What the browser may load. This is the policy the production site is served under (Cloudflare Pages reads this file),
# and "npm run preview" serves the build under it too, so a break shows up before it reaches production.
#
#  - no inline scripts and no eval: script-src has no 'unsafe-inline' or 'unsafe-eval'
#  - Cloudflare Turnstile is the only other origin: its script, its frame, and its own requests
#  - the app talks only to its own origin (the proxy sends /api on to the API)
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; manifest-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable
