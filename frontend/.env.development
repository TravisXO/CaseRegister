# Public values only. Every VITE_ variable is built into the JavaScript the browser downloads, so anyone can read it.
# Never put a secret, key, token or password in this file. Secrets belong in the API's user-secrets or environment.
# This one is Cloudflare's published Turnstile test site key, which always passes.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
