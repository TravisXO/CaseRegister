# What the browser may load. This is the policy the production site is served under (Cloudflare Pages reads this file),
# and "npm run preview" serves the build under the first block of it too, so a break shows up before it reaches production.
#
#  - no inline scripts and no eval: script-src has no 'unsafe-inline' or 'unsafe-eval'
#  - Cloudflare Turnstile is the only other origin: its script, its frame, and its own requests
#  - the app talks only to its own origin (the Pages Function sends /api on to the API)
#
# These rules apply to the pages and files. Responses from the Pages Function (/api/*) do not pass through this file; the API sends its own
# security headers, and the function adds noindex.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; manifest-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-cache

# Built files have a hash in their name, so they never change under that name: keep them for a year. Everything else (index.html, and the
# address every other page is answered with) is checked again on every visit, so a new deploy shows at once.
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
